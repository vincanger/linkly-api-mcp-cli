# Copy to .env.server for local development.
# Skips email verification when signing up locally (Wasp dev only).
SKIP_EMAIL_VERIFICATION_IN_DEV=true
# Signs the state MCP clients echo back when they confirm a deletion (URL-mode
# elicitation). At least 32 bytes, the same on every server instance. This
# value is for local development only: in production, generate a fresh one
# with `openssl rand -base64 32`.
MCP_REQUEST_STATE_KEY=dev-only-linkly-request-state-key-change-me

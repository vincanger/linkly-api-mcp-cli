{
  "openapi": "3.1.0",
  "info": {
    "title": "Linkly API",
    "version": "1.0.0",
    "description": "Shorten links and read click analytics. Every operation declares `x-destructive`. The same operations are available as MCP tools at /mcp and as the `linkly` CLI."
  },
  "servers": [
    {
      "url": "http://localhost:3001/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal access token (lk_pat_…) from /settings/tokens, or an OAuth access token (lk_at_…)."
      },
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 authorization code with PKCE (S256). Clients identify themselves with a Client ID Metadata Document URL; no registration needed. Request `resource=http://localhost:3001/api/v1`.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:3000/oauth/authorize",
            "tokenUrl": "http://localhost:3001/oauth/token",
            "refreshUrl": "http://localhost:3001/oauth/token",
            "scopes": {
              "links:read": "View your links",
              "links:write": "Create, edit, and delete your links",
              "analytics:read": "View click analytics"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code, e.g. not_found, forbidden, conflict, invalid, unauthorized."
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation, often with what to do next."
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Link": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable link ID."
          },
          "slug": {
            "type": "string",
            "description": "Short code; the short URL is /r/<slug>."
          },
          "destinationUrl": {
            "type": "string",
            "description": "Where the short link redirects."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional label."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags on the link."
          },
          "archived": {
            "type": "boolean",
            "description": "Whether the link is archived (not redirecting)."
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601 creation time."
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO 8601 last update time."
          },
          "shortUrl": {
            "type": "string",
            "description": "The public short URL to share."
          },
          "dashboardUrl": {
            "type": "string",
            "description": "Opens this link in the Linkly dashboard."
          }
        },
        "required": [
          "id",
          "slug",
          "destinationUrl",
          "title",
          "tags",
          "archived",
          "createdAt",
          "updatedAt",
          "shortUrl",
          "dashboardUrl"
        ]
      },
      "Whoami": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Your Linkly user ID."
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "description": "The username you log in with."
          },
          "source": {
            "type": "string",
            "enum": [
              "session",
              "pat",
              "oauth"
            ],
            "description": "How this request is authenticated: dashboard session, personal access token, or OAuth connection."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "links:read",
                "links:write",
                "analytics:read"
              ]
            },
            "description": "Permissions this caller has."
          },
          "toolsets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "links",
                "analytics"
              ]
            },
            "description": "Toolsets fully covered by those permissions."
          },
          "confirmDestructive": {
            "type": "boolean",
            "description": "If true, deletions return a confirmation link for the user instead of deleting immediately."
          },
          "clientName": {
            "type": [
              "string",
              "null"
            ],
            "description": "For OAuth connections, the name of the connected app."
          },
          "dashboardUrl": {
            "type": "string",
            "description": "Opens the Linkly dashboard."
          }
        },
        "required": [
          "userId",
          "username",
          "source",
          "scopes",
          "toolsets",
          "confirmDestructive",
          "clientName",
          "dashboardUrl"
        ]
      },
      "LinkPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "description": "Links on this page, newest first."
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` to get the next page; null when there are no more."
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "LinkInput": {
        "type": "object",
        "properties": {
          "destinationUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "The full URL the short link redirects to. Must start with http:// or https://."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,40}$",
            "description": "Custom slug. Omit it to get a random 7-character slug."
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional human-readable label for the link."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "maxItems": 10,
            "description": "Up to 10 tags (each up to 30 chars). Stored lowercase."
          }
        },
        "required": [
          "destinationUrl"
        ]
      },
      "LinkUpdate": {
        "type": "object",
        "properties": {
          "destinationUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "New destination URL (http:// or https://)."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,40}$",
            "description": "New slug. The old short URL stops working."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "New title. Pass null to remove it."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "maxItems": 10,
            "description": "Replaces the whole tag list."
          },
          "archived": {
            "type": "boolean",
            "description": "Archived links stop redirecting (their short URL returns 404) and are hidden from lists by default."
          }
        }
      },
      "DeleteResult": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "deleted"
                ],
                "description": "The link was deleted."
              },
              "id": {
                "type": "string",
                "description": "ID of the deleted link."
              },
              "slug": {
                "type": "string",
                "description": "Slug of the deleted link."
              }
            },
            "required": [
              "status",
              "id",
              "slug"
            ]
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "confirmation_required"
                ],
                "description": "The user must confirm in Linkly before anything is deleted."
              },
              "confirmUrl": {
                "type": "string",
                "description": "Share this URL with the user; the link is deleted when they confirm."
              },
              "actionId": {
                "type": "string",
                "description": "ID of the pending deletion."
              },
              "expiresAt": {
                "type": "string",
                "description": "ISO 8601 time when the confirmation link expires."
              },
              "message": {
                "type": "string",
                "description": "Explanation to relay to the user."
              }
            },
            "required": [
              "status",
              "confirmUrl",
              "actionId",
              "expiresAt",
              "message"
            ]
          }
        ]
      },
      "LinkStats": {
        "type": "object",
        "properties": {
          "linkId": {
            "type": "string",
            "description": "ID of the link."
          },
          "slug": {
            "type": "string",
            "description": "Slug of the link."
          },
          "range": {
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d",
              "90d"
            ],
            "description": "The time window used."
          },
          "groupBy": {
            "type": "string",
            "enum": [
              "day",
              "referrer"
            ],
            "description": "How the series is grouped."
          },
          "total": {
            "type": "integer",
            "description": "Total clicks in the time window."
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "A UTC day (YYYY-MM-DD) or a referrer hostname."
                },
                "clicks": {
                  "type": "integer",
                  "description": "Clicks for this key."
                }
              },
              "required": [
                "key",
                "clicks"
              ]
            },
            "description": "Click counts per key. Days are oldest first; referrers are most clicks first."
          },
          "dashboardUrl": {
            "type": "string",
            "description": "Opens an interactive chart of these stats in the Linkly dashboard. Share it with the user."
          }
        },
        "required": [
          "linkId",
          "slug",
          "range",
          "groupBy",
          "total",
          "series",
          "dashboardUrl"
        ]
      },
      "TopLinks": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d",
              "90d"
            ],
            "description": "The time window used."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "link": {
                  "$ref": "#/components/schemas/Link"
                },
                "clicks": {
                  "type": "integer",
                  "description": "Clicks in the time window."
                }
              },
              "required": [
                "link",
                "clicks"
              ]
            },
            "description": "Links with the most clicks, most first. Links with zero clicks are left out."
          },
          "dashboardUrl": {
            "type": "string",
            "description": "Opens the top-links view in the Linkly dashboard. Share it with the user."
          }
        },
        "required": [
          "range",
          "data",
          "dashboardUrl"
        ]
      },
      "DocSearchResults": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocSearchResult"
            },
            "description": "Matching docs, best first."
          }
        },
        "required": [
          "results"
        ]
      },
      "DocSearchResult": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Pass to read_doc (or GET /docs/{slug}) for the full text."
          },
          "title": {
            "type": "string",
            "description": "Doc title."
          },
          "snippet": {
            "type": "string",
            "description": "A short excerpt around the best match."
          },
          "score": {
            "type": "number",
            "description": "Relevance score; higher is better."
          },
          "url": {
            "type": "string",
            "description": "Opens the doc in the Linkly dashboard."
          }
        },
        "required": [
          "slug",
          "title",
          "snippet",
          "score",
          "url"
        ]
      },
      "Doc": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Doc slug."
          },
          "title": {
            "type": "string",
            "description": "Doc title."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Topics the doc covers."
          },
          "markdown": {
            "type": "string",
            "description": "The full doc as Markdown."
          },
          "url": {
            "type": "string",
            "description": "Opens the doc in the Linkly dashboard."
          }
        },
        "required": [
          "slug",
          "title",
          "tags",
          "markdown",
          "url"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/me": {
      "get": {
        "operationId": "whoami",
        "tags": [
          "Account"
        ],
        "summary": "Who am I",
        "description": "Returns the caller's identity and permissions. Useful for checking a token.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth2": []
          }
        ],
        "x-destructive": false,
        "responses": {
          "200": {
            "description": "The caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Whoami"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/links": {
      "get": {
        "operationId": "listLinks",
        "tags": [
          "Links"
        ],
        "summary": "List links",
        "description": "Your links, newest first, with optional search and tag filters. Cursor-paginated.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth2": [
              "links:read"
            ]
          }
        ],
        "x-destructive": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 200,
              "description": "Case-insensitive text matched against slug, title, and destination URL."
            },
            "required": false,
            "description": "Case-insensitive text matched against slug, title, and destination URL.",
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 30,
              "description": "Only links that have this tag."
            },
            "required": false,
            "description": "Only links that have this tag.",
            "name": "tag",
            "in": "query"
          },
          {
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              ],
              "default": false,
              "description": "false (default): only active links. true: only archived links."
            },
            "required": false,
            "description": "false (default): only active links. true: only archived links.",
            "name": "archived",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque cursor from a previous response's `nextCursor`, to fetch the next page."
            },
            "required": false,
            "description": "Opaque cursor from a previous response's `nextCursor`, to fetch the next page.",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "How many items to return, 1–100. Defaults to 25."
            },
            "required": false,
            "description": "How many items to return, 1–100. Defaults to 25.",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token doesn't have the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createLink",
        "tags": [
          "Links"
        ],
        "summary": "Create a link",
        "description": "Creates a short link. Omit `slug` to get a random 7-character one.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth2": [
              "links:write"
            ]
          }
        ],
        "x-destructive": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Link"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token doesn't have the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict, e.g. the slug is taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/links/{id}": {
      "get": {
        "operationId": "getLink",
        "tags": [
          "Links"
        ],
        "summary": "Get a link",
        "description": "Looks up one link by ID or slug.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth2": [
              "links:read"
            ]
          }
        ],
        "x-destructive": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The link's ID or slug."
            },
            "required": true,
            "description": "The link's ID or slug.",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Link"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token doesn't have the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by someone else).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateLink",
        "tags": [
          "Links"
        ],
        "summary": "Update a link",
        "description": "Changes only the fields you send. Setting `archived: true` stops the short URL from redirecting.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth2": [
              "links:write"
            ]
          }
        ],
        "x-destructive": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The link's ID or slug."
            },
            "required": true,
            "description": "The link's ID or slug.",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Link"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token doesn't have the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found (or owned by someone else).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict, e.g. the slug is taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteLink",
        "tags": [
          "Links"
        ],
        "summary": "Delete a link",
        "description": "Permanently deletes a link and its click history. With a personal access token it's deleted immediately (200). With an OAuth token whose connection requires confirmation, nothing is deleted yet: you get 202 with a `confirmUrl` to share with the user.",
        "security": [
          {
            "bearer": []
          },
          {
            "oauth2": [
              "links:write"
            ]
          }
        ],
        "x-destructive": true,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The link's ID or slug."
            },
            "required": true,
            "description": "The link's ID or slug.",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
